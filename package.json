{
  "name": "practice-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Music analysis and practice desktop app",
  "author": "Nattuhan",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "build": "esbuild frontend/src/app.js --bundle --format=esm --platform=browser --target=es2022 --outfile=public/app.js",
    "build:watch": "npm run build -- --watch",
    "desktop:start": "electron .",
    "desktop:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build_desktop_backend.ps1",
    "desktop:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare_desktop_binaries.ps1",
    "desktop:dist": "electron-builder --win nsis",
    "test:unit": "node --test frontend/tests/*.test.js desktop/tests/*.test.cjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "lucide": "0.468.0",
    "wavesurfer.js": "7.12.11"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "jp.nattuhan.practicelab",
    "productName": "PracticeLab",
    "asar": true,
    "directories": {
      "output": "desktop/dist/installer"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/legacy-cloud-settings.cjs",
      "desktop/player-settings.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop/dist/backend/practice-lab-backend",
        "to": "backend"
      },
      {
        "from": "desktop/bin",
        "to": "bin"
      },
      {
        "from": "public",
        "to": "app/public",
        "filter": [
          "index.html",
          "app.js",
          "styles.css"
        ]
      },
      {
        "from": "practice_lab",
        "to": "app/practice_lab",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "scripts",
        "to": "app/scripts",
        "filter": [
          "analyze_audio.py",
          "split_stems.py",
          "setup_desktop_nvidia.ps1",
          "setup_wsl_runtime.sh"
        ]
      },
      {
        "from": "torchaudio",
        "to": "app/torchaudio",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "desktop/assets/practicelab-icon.ico",
      "artifactName": "PracticeLab-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PracticeLab"
    },
    "publish": {
      "provider": "github",
      "owner": "Nattuhan",
      "repo": "practice-lab",
      "releaseType": "release"
    }
  }
}
